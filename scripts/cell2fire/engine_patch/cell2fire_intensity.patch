+// WFEDS: plain row-major grid of doubles (%.1f), one raster row per line.
+// Used for the Intensity<NN>.csv dumps (max free Byram FI per cell, kW/m).
+void CSVWriter::printCSVDoubleGrid(int rows, int cols, std::vector<double> & grid){
+	std::ofstream ofs(this->fileName, std::ofstream::out);
+	char buf[32];
+	for (int r = 0; r < rows; r++){
+		std::string line;
+		for (int c = 0; c < cols; c++){
+			snprintf(buf, sizeof(buf), "%.1f", grid[r*cols + c]);
+			line += buf;
+			if (c != cols - 1) line += this->delimeter;
+		}
+		ofs << line << "\n";
+	}
+	ofs.close();
+}
