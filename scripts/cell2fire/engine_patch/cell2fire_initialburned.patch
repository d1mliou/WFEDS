+	// ignition so it spreads at t=0. Active only when --InitialBurned is given.
+	if (!this->InitialBurnedCells.empty()){
+		int wfeds_seeded = 0;
+		std::unordered_map<int, CellsFBP>::iterator wfeds_it;
+		for (int wfeds_cell : this->InitialBurnedCells){
+			if (wfeds_cell < 1 || wfeds_cell > this->nCells) continue;
+			if (this->burntCells.find(wfeds_cell) != this->burntCells.end()) continue;
+			if (this->statusCells[wfeds_cell-1] >= 3) continue;   // harvested / non-burnable
